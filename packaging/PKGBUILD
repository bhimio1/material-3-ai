# Maintainer: bhimio1
pkgname=material-3-ai-git
pkgver=0.1.0
pkgrel=1
pkgdesc="Material 3 desktop app for Claude Code"
arch=('x86_64' 'aarch64')
url="https://github.com/bhimio1/material-3-ai"
license=('MIT')
depends=('libxkbcommon' 'wayland' 'libglvnd' 'xdg-utils')
makedepends=('cargo' 'git')
# Material 3 AI drives your own `claude` command. Install it from the AUR
# (claude-code) or with Anthropic's installer, then sign in from Settings.
optdepends=(
  'claude-code: the Claude Code CLI this app runs (or use the official installer)'
  'xdg-desktop-portal: native folder and image pickers'
  'libnotify: desktop notifications (notify-send)'
)
provides=('material-3-ai')
conflicts=('material-3-ai' 'material-3-ai-bin')
source=("$pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$pkgname"
  printf "0.1.0.r%s.g%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen
}

package() {
  cd "$pkgname"
  install -Dm755 target/release/m3-ai "$pkgdir/usr/bin/m3-ai"
  install -Dm644 packaging/material_3_ai.desktop "$pkgdir/usr/share/applications/material_3_ai.desktop"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 assets/fonts/LICENSE-Inter.txt "$pkgdir/usr/share/licenses/$pkgname/LICENSE-Inter.txt"
}
