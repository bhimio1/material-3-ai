#!/usr/bin/env python3
"""A stand-in for the `claude` CLI that speaks the stream-json protocol with
canned replies. It never contacts a model. Used by the integration test and
for screenshots: `M3_AI_CLAUDE=scripts/dev/fake-claude m3-ai DIR`.

Prompts containing:
  "permission" -> asks to run a Bash command, then reports the outcome
  "slow"       -> streams until interrupted
  "demo"       -> a rich reply: markdown, code, tool calls, a diff, todos,
                  and finally a pending permission request for a Write
anything else  -> a short streamed answer
"""
import json, sys, time, uuid

if "--version" in sys.argv:
    print("2.1.304 (Claude Code)"); sys.exit(0)
if sys.argv[1:3] == ["auth", "status"]:
    print(json.dumps({"loggedIn": True, "authMethod": "oauth_token", "apiProvider": "firstParty"})); sys.exit(0)

SESSION = "5f0c2d0e-8a51-4c4e-9b8e-6d0c1f2a3b4c"
MODEL = "sonnet"
cost = 0.0

def out(obj):
    sys.stdout.write(json.dumps(obj) + "\n"); sys.stdout.flush()

def read():
    line = sys.stdin.readline()
    if not line:
        sys.exit(0)
    return json.loads(line)

def stream_text(msg_id, index, text, delay=0.01):
    out({"type": "stream_event", "event": {"type": "content_block_start", "index": index, "content_block": {"type": "text", "text": ""}}, "parent_tool_use_id": None, "session_id": SESSION})
    for i in range(0, len(text), 12):
        out({"type": "stream_event", "event": {"type": "content_block_delta", "index": index, "delta": {"type": "text_delta", "text": text[i:i+12]}}, "parent_tool_use_id": None, "session_id": SESSION})
        time.sleep(delay)
    out({"type": "stream_event", "event": {"type": "content_block_stop", "index": index}, "parent_tool_use_id": None, "session_id": SESSION})
    out({"type": "assistant", "message": {"id": msg_id, "role": "assistant", "model": MODEL, "content": [{"type": "text", "text": text}], "usage": {"input_tokens": 12, "cache_read_input_tokens": 41200, "output_tokens": 300}}, "parent_tool_use_id": None, "session_id": SESSION})

def start(msg_id):
    out({"type": "stream_event", "event": {"type": "message_start", "message": {"id": msg_id, "usage": {"input_tokens": 12, "cache_read_input_tokens": 41200}}}, "parent_tool_use_id": None, "session_id": SESSION})

def tool(msg_id, tid, name, inp, result, structured=None, parent=None):
    out({"type": "assistant", "message": {"id": msg_id, "role": "assistant", "content": [{"type": "tool_use", "id": tid, "name": name, "input": inp}]}, "parent_tool_use_id": parent, "session_id": SESSION})
    if result is not None:
        u = {"type": "user", "message": {"role": "user", "content": [{"type": "tool_result", "tool_use_id": tid, "content": result}]}, "parent_tool_use_id": parent, "session_id": SESSION}
        if structured is not None:
            u["tool_use_result"] = structured
        out(u)

def result(text, error=False, subtype="success"):
    global cost
    cost += 0.0412
    out({"type": "result", "subtype": subtype, "is_error": error, "duration_ms": 8400, "num_turns": 3, "result": text, "session_id": SESSION, "total_cost_usd": round(cost, 4), "usage": {"input_tokens": 12, "cache_read_input_tokens": 41200, "output_tokens": 812}})

def wait_control(request_id):
    while True:
        m = read()
        if m.get("type") == "control_response" and m["response"].get("request_id") == request_id:
            return m["response"]

initialized = False
while True:
    m = read()
    if m.get("type") == "control_request":
        req = m["request"]; rid = m["request_id"]
        if req.get("subtype") == "initialize":
            out({"type": "control_response", "response": {"subtype": "success", "request_id": rid, "response": {
                "commands": [{"name": "review", "description": "Review a pull request", "argumentHint": "[pr]"},
                             {"name": "compact", "description": "Summarize the conversation to save context", "argumentHint": ""},
                             {"name": "init", "description": "Write a CLAUDE.md for this project", "argumentHint": ""}],
                "models": [{"value": "default", "displayName": "Default (recommended)", "description": "Sonnet 5.5"},
                           {"value": "opus", "displayName": "Opus", "description": "Opus 5.5 · most capable"},
                           {"value": "haiku", "displayName": "Haiku", "description": "Fastest"}],
                "claude_code_version": "2.1.304", "current_permission_mode": "default"}}})
        else:
            out({"type": "control_response", "response": {"subtype": "success", "request_id": rid, "response": {}}})
        continue
    if m.get("type") != "user":
        continue
    content = m["message"]["content"]
    text = content if isinstance(content, str) else " ".join(b.get("text", "") for b in content if b.get("type") == "text")
    if not initialized:
        out({"type": "system", "subtype": "init", "session_id": SESSION, "cwd": ".", "model": MODEL, "tools": ["Bash", "Read", "Edit", "Write", "Grep", "TodoWrite", "Task"],
             "mcp_servers": [{"name": "github", "status": "connected"}], "permissionMode": "default", "claude_code_version": "2.1.304", "slash_commands": ["review", "compact", "init"]})
        out({"type": "autocompact_state", "value": {"enabled": True, "effective_window": 200000}})
        initialized = True
    if "permission" in text:
        start("m-p1")
        out({"type": "control_request", "request_id": "perm-1", "request": {"subtype": "can_use_tool", "tool_name": "Bash", "input": {"command": "rm -rf build", "description": "Clean the build folder"},
             "tool_use_id": "toolu_p1", "permission_suggestions": [{"type": "addRules", "rules": [{"toolName": "Bash", "ruleContent": "rm -rf build"}], "behavior": "allow", "destination": "localSettings"}]}})
        resp = wait_control("perm-1")
        behavior = resp["response"]["behavior"]
        if behavior == "allow":
            tool("m-p1", "toolu_p1", "Bash", resp["response"]["updatedInput"], "", {"stdout": "", "stderr": "", "interrupted": False})
            stream_text("m-p2", 0, "Cleaned the build folder.")
            result("allowed:" + json.dumps(resp["response"].get("updatedPermissions", [])))
        else:
            stream_text("m-p2", 0, "OK, I won't delete it. (" + resp["response"].get("message", "") + ")")
            result("denied")
    elif "slow" in text:
        start("m-s1")
        out({"type": "stream_event", "event": {"type": "content_block_start", "index": 0, "content_block": {"type": "text", "text": ""}}, "parent_tool_use_id": None})
        out({"type": "stream_event", "event": {"type": "content_block_delta", "index": 0, "delta": {"type": "text_delta", "text": "Working on it"}}, "parent_tool_use_id": None})
        while True:
            c = read()
            if c.get("type") == "control_request" and c["request"].get("subtype") == "interrupt":
                out({"type": "control_response", "response": {"subtype": "success", "request_id": c["request_id"], "response": {}}})
                result("interrupted", True, "error_during_execution")
                break
    elif "demo" in text:
        start("m-d1")
        out({"type": "stream_event", "event": {"type": "content_block_start", "index": 0, "content_block": {"type": "thinking", "thinking": ""}}, "parent_tool_use_id": None})
        out({"type": "stream_event", "event": {"type": "content_block_delta", "index": 0, "delta": {"type": "thinking_delta", "thinking": "The login form reads the token before it's set. I should check auth.rs."}}, "parent_tool_use_id": None})
        out({"type": "assistant", "message": {"id": "m-d1", "content": [{"type": "thinking", "thinking": "The login form reads the token before it's set. I should check auth.rs."}]}, "parent_tool_use_id": None})
        tool("m-d2", "t-todo", "TodoWrite", {"todos": [{"content": "Find where the session token is read", "status": "completed"}, {"content": "Fix the race in login()", "status": "in_progress"}, {"content": "Add a regression test", "status": "pending"}]}, "Todos updated")
        tool("m-d3", "t-grep", "Grep", {"pattern": "session_token", "path": "src"}, "src/auth.rs:42\nsrc/login.rs:17")
        tool("m-d4", "t-bash", "Bash", {"command": "cargo test auth", "description": "Run the auth tests"}, "", {"stdout": "running 4 tests\ntest auth::login_sets_token ... FAILED\ntest auth::logout ... ok\n\ntest result: FAILED. 3 passed; 1 failed", "stderr": "", "interrupted": False})
        tool("m-d5", "t-edit", "Edit", {"file_path": "src/auth.rs", "old_string": "let token = self.token.clone();\nself.store(token);\nself.token = fetch_token()?;", "new_string": "self.token = fetch_token()?;\nlet token = self.token.clone();\nself.store(token);"}, "The file src/auth.rs has been updated.")
        md = ("Found it. `login()` stored the **old** token before fetching the new one, so the first request after signing in used an empty token.\n\n"
              "### What changed\n\n1. Fetch the token first\n2. Then store it\n\n```rust\npub fn login(&mut self) -> Result<()> {\n    self.token = fetch_token()?;\n    let token = self.token.clone();\n    self.store(token); // now non-empty\n    Ok(())\n}\n```\n\n"
              "Next I'll add a regression test. See the [Rust book on error handling](https://doc.rust-lang.org/book/ch09-00-error-handling.html) for `?`.")
        start("m-d6")
        stream_text("m-d6", 0, md, 0.0)
        out({"type": "control_request", "request_id": "perm-demo", "request": {"subtype": "can_use_tool", "tool_name": "Write", "input": {"file_path": "tests/login.rs", "content": "#[test]\nfn login_sets_token() {\n    let mut s = Session::new();\n    s.login().unwrap();\n    assert!(!s.token().is_empty());\n}\n"}, "tool_use_id": "toolu_w1"}})
        resp = wait_control("perm-demo")
        result("done")
    else:
        start("m-1")
        stream_text("m-1", 0, "Hello! I can see the project. What would you like to do?")
        result("ok")
